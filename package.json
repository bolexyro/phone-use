{
  "name": "phone-control-workspace",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present --sort build",
    "typecheck": "pnpm --filter @dhd/screenshot-markers build && pnpm --filter @dhd/phone-control build && pnpm --recursive --if-present --sort typecheck",
    "test": "pnpm --filter @dhd/screenshot-markers build && pnpm --filter @dhd/phone-control build && pnpm --recursive --if-present --sort test",
    "phone-control-mcp:start": "pnpm --filter @dhd/phone-control-mcp start",
    "phone-control-mcp:dev": "pnpm --filter @dhd/phone-control-mcp dev",
    "phone-control-viewer:start": "pnpm --filter @dhd/phone-viewer start",
    "companion:build": "pnpm --filter @dhd/dhd-companion build",
    "companion:dashboard": "pnpm --filter @dhd/dhd-companion dashboard",
    "companion:worker": "pnpm --filter @dhd/dhd-companion worker",
    "companion:tools": "pnpm --filter @dhd/dhd-companion tools",
    "companion:bridge-demo": "pnpm --filter @dhd/dhd-companion bridge-demo"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "tsx": "^4.23.12",
    "typescript": "5.8.3",
    "vitest": "3.2.4"
  }
}
